{
  "name": "dsh-novel-assist",
  "version": "1.0.0",
  "type": "module",
  "description": "Novel writing assistant panel: bind a local manuscript folder and keep creation parameters in view.",
  "license": "MIT",
  "author": "ReWebaiyu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReWebaiyu/dsh-novel-assist.git"
  },
  "homepage": "https://github.com/ReWebaiyu/dsh-novel-assist#readme",
  "bugs": {
    "url": "https://github.com/ReWebaiyu/dsh-novel-assist/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "novel",
    "writing",
    "assistant",
    "panel"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "rank.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/*.md",
    "src/build-client.mjs",
    "src/client/*.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
